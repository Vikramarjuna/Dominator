#! /bin/bash --posix

# setup-scratch-fleet: Set up an isolated fleet-manager + hypervisor on the
#                      local host for testing scratch-built images end to end.
#
# Usage: setup-scratch-fleet command [args]
# Commands:
#   setup                First-time setup and start.
#   start                Start network + services (after stop or reboot).
#   stop                 Stop services and tear down the network.
#   restart              Stop and start.
#   status               Show which services are running.
#   env                  Print shell aliases (sf-vm, sf-hyper).
#   create-vm stream [name]
#                        Create a VM from a scratch imageserver stream.
#   destroy-vm ipAddr    Destroy a VM by IP address.
#   teardown             Stop, remove the bridge and all state.
#
# Environment variables (defaults shown):
#   SCRATCH_DIR        (default: ~/scratch-fleet)
#   IMAGINATOR_DIR     (default: ~/scratch-imaginator) — source of the CA,
#                      client cert dir and the scratch imageserver.
#   HYPERVISOR_PORT    (default: 6976)
#   FLEET_MANAGER_PORT (default: 6977)
#   IMAGESERVER_PORT   (default: 26971) — scratch imageserver to pull from.

set -eu

SCRATCH_DIR="${SCRATCH_DIR:-$HOME/scratch-fleet}"
IMAGINATOR_DIR="${IMAGINATOR_DIR:-$HOME/scratch-imaginator}"
HYPERVISOR_PORT="${HYPERVISOR_PORT:-6976}"
FLEET_MANAGER_PORT="${FLEET_MANAGER_PORT:-6977}"
IMAGESERVER_PORT="${IMAGESERVER_PORT:-26971}"

# Network constants. The bridge is named br@<subnetId> so the hypervisor's
# getBridgeForSubnet binds the subnet to it by name, before any VlanId lookup.
# This needs no VLAN uplink and avoids docker0 (which occupies VlanId 0).
readonly SUBNET_ID=scratch
readonly BRIDGE="br@$SUBNET_ID"
readonly GATEWAY=192.168.66.1
readonly NETMASK=255.255.255.0
readonly POOL_PREFIX=192.168.66
readonly POOL_FIRST=10
readonly POOL_LAST=59

readonly STATE_FILE="$SCRATCH_DIR/etc/scratch.env"
readonly CA_PEM="$IMAGINATOR_DIR/tls/ca.pem"
readonly CA_KEY="$IMAGINATOR_DIR/tls/ca.key"
readonly CLIENT_DIR="$IMAGINATOR_DIR/tls/client-dir"

die () {
    echo "$1" >&2
    exit 1
}

need_tool () {
    command -v "$1" > /dev/null 2>&1 || die "'$1' not found in PATH ($2)"
}

check_prereqs () {
    need_tool ip      "install: sudo apt-get install -y iproute2"
    need_tool ebtables "install: sudo apt-get install -y ebtables"
    need_tool openssl "install: sudo apt-get install -y openssl"
    need_tool qemu-system-x86_64 "install: sudo apt-get install -y qemu-system-x86"
    need_tool sudo    "sudo is required (hypervisor manipulates bridges and namespaces)"
    [ -f "$CA_PEM" ] && [ -f "$CA_KEY" ] || \
        die "scratch-imaginator CA not found at $CA_PEM — run setup-scratch-imaginator first"
    [ -f "$CLIENT_DIR/cert.pem" ] || \
        die "scratch-imaginator client cert not found at $CLIENT_DIR — run setup-scratch-imaginator first"
    [ -e /dev/kvm ] || die "/dev/kvm not present — KVM is required to boot VMs"
}

load_state () {
    # shellcheck disable=SC1090
    [ -f "$STATE_FILE" ] && . "$STATE_FILE"
    return 0
}

save_state () {
    cat > "$STATE_FILE" <<EOF
HYPERVISOR_PORT="$HYPERVISOR_PORT"
FLEET_MANAGER_PORT="$FLEET_MANAGER_PORT"
IMAGESERVER_PORT="$IMAGESERVER_PORT"
IMAGINATOR_DIR="$IMAGINATOR_DIR"
EOF
}

main () {
    [ $# -ge 1 ] || die "usage: $0 command [args]"
    local cmd="$1"; shift
    case "$cmd" in
        setup)      cmd_setup "$@" ;;
        start)      cmd_start "$@" ;;
        stop)       cmd_stop "$@" ;;
        restart)    cmd_stop; cmd_start ;;
        status)     cmd_status "$@" ;;
        env)        cmd_env "$@" ;;
        create-vm)  cmd_create_vm "$@" ;;
        destroy-vm) cmd_destroy_vm "$@" ;;
        teardown)   cmd_teardown "$@" ;;
        *)          die "unknown command: $cmd" ;;
    esac
}

make_dirs () {
    mkdir -p \
        "$SCRATCH_DIR/bin" \
        "$SCRATCH_DIR/tls" \
        "$SCRATCH_DIR/etc/topology/$SUBNET_ID" \
        "$SCRATCH_DIR/var/lib/hypervisor" \
        "$SCRATCH_DIR/var/lib/fleet-manager" \
        "$SCRATCH_DIR/var/log/hypervisor" \
        "$SCRATCH_DIR/var/log/fleet-manager"
}

# Provide the four binaries in bin/. Preference order: (1) binaries already
# present in bin/ (e.g. cross-compiled elsewhere and copied in — the dev VM
# has no go toolchain); (2) go install from the Dominator checkout this script
# lives in; (3) copy from ~/go/bin.
build_binaries () {
    local have_all=1 b
    for b in hypervisor fleet-manager vm-control hyper-control; do
        [ -x "$SCRATCH_DIR/bin/$b" ] || have_all=0
    done
    if [ "$have_all" = 1 ]; then
        echo "[=] binaries already present in bin/; using them"
        return
    fi
    local repo
    repo="$(cd "$(dirname "$0")/.." 2> /dev/null && pwd)" || repo=""
    if [ -n "$repo" ] && [ -f "$repo/go.mod" ] && command -v go > /dev/null 2>&1
    then
        echo "[+] building hypervisor, fleet-manager, vm-control, hyper-control"
        ( cd "$repo" && GOBIN="$SCRATCH_DIR/bin" go install \
            ./cmd/hypervisor ./cmd/fleet-manager \
            ./cmd/vm-control ./cmd/hyper-control )
    else
        echo "[=] not a Dominator checkout (or go missing); copying from ~/go/bin"
        local b
        for b in hypervisor fleet-manager vm-control hyper-control; do
            [ -x "$HOME/go/bin/$b" ] || die "$HOME/go/bin/$b missing; build it first"
            cp "$HOME/go/bin/$b" "$SCRATCH_DIR/bin/$b"
        done
    fi
    local b
    for b in hypervisor fleet-manager vm-control hyper-control; do
        [ -x "$SCRATCH_DIR/bin/$b" ] || die "failed to provide $SCRATCH_DIR/bin/$b"
    done
}

# Mint hypervisor and fleet-manager server certs signed by the scratch
# imaginator CA. The cert CN is the srpc "user"; server_exts grants serverAuth
# (they are servers) and clientAuth (the hypervisor is a client of the
# imageserver, the fleet-manager is a client of the hypervisor). The client
# cert for vm-control/hyper-control is reused from the imaginator stack.
gen_certs () {
    local tls="$SCRATCH_DIR/tls"
    # The hypervisor run script needs the CA under $SCRATCH_DIR (no absolute
    # imaginator path), so keep a copy current regardless of whether the
    # server certs below still need minting.
    cp "$CA_PEM" "$tls/ca-copy.pem"
    if [ -f "$tls/hypervisor.cert" ] && [ -f "$tls/fleet-manager.cert" ]; then
        echo "[=] fleet TLS certificates already exist; skipping generation"
        return
    fi
    echo "[+] minting hypervisor and fleet-manager certs from the imaginator CA"
    cat > "$tls/openssl.cnf" <<'EOF'
[req]
distinguished_name = dn
[dn]
[server_exts]
subjectAltName = DNS:localhost, IP:127.0.0.1
extendedKeyUsage = serverAuth, clientAuth
EOF
    _issue () {
        openssl req -new -nodes -newkey rsa:2048 -batch \
            -subj "/CN=$2" -keyout "$tls/$1.key" -out "$tls/$1.csr" 2> /dev/null
        openssl x509 -req -in "$tls/$1.csr" \
            -CA "$CA_PEM" -CAkey "$CA_KEY" -CAcreateserial \
            -days 30 -extfile "$tls/openssl.cnf" -extensions server_exts \
            -out "$tls/$1.cert" 2> /dev/null
        rm -f "$tls/$1.csr"
        chmod 600 "$tls/$1.key"
    }
    _issue hypervisor    hypervisor-scratch
    _issue fleet-manager fleet-manager-scratch
}

# Bring up a host-only bridge named br@<subnetId>. The hypervisor's
# getBridgeForSubnet binds subnet Id "scratch" to a bridge literally named
# "br@scratch" by name (before any VlanId lookup), so no VLAN uplink or dummy
# is needed and docker0 (which occupies VlanId 0) is never chosen. No physical
# NIC and no NAT: VMs are reachable from this host only.
net_up () {
    if ip link show "$BRIDGE" > /dev/null 2>&1; then
        echo "[=] bridge $BRIDGE already present"
        return
    fi
    echo "[+] creating host-only bridge $BRIDGE (sudo)"
    sudo ip link add "$BRIDGE" type bridge
    sudo ip link set "$BRIDGE" up
    sudo ip addr add "$GATEWAY/24" dev "$BRIDGE"
}

net_down () {
    echo "[-] removing bridge $BRIDGE (sudo)"
    sudo ip link del "$BRIDGE" 2> /dev/null || true
}

pid_hypervisor () {
    pgrep -f "bin/hypervisor -portNum=${HYPERVISOR_PORT}" 2> /dev/null || true
}

start_hypervisor () {
    [ -n "$(pid_hypervisor)" ] && { echo "[=] hypervisor already running"; return; }
    local run="$SCRATCH_DIR/bin/run-hypervisor"
    cat > "$run" <<EOF
#! /bin/bash --posix
cd "$SCRATCH_DIR"
exec ./bin/hypervisor \\
    -portNum=$HYPERVISOR_PORT \\
    -imageServerHostname=localhost -imageServerPortNum=$IMAGESERVER_PORT \\
    -CAfile=./tls/ca-copy.pem -identityCAfile=./tls/ca-copy.pem \\
    -certFile=./tls/hypervisor.cert -keyFile=./tls/hypervisor.key \\
    -stateDir=./var/lib/hypervisor \\
    -logDir=./var/log/hypervisor \\
    -srpcTrustedUsers=$USER,fleet-manager-scratch \\
    -alsoLogToStderr
EOF
    chmod +x "$run"
    echo "[+] starting hypervisor (sudo) on :$HYPERVISOR_PORT"
    sudo -b setsid "$run" </dev/null \
        >> "$SCRATCH_DIR/var/log/hypervisor.stdout" 2>&1
    sleep 4
}

stop_hypervisor () {
    local pid
    pid=$(pid_hypervisor)
    [ -n "$pid" ] && { echo "[-] stopping hypervisor (sudo)"; sudo kill "$pid" 2> /dev/null || true; }
    return 0
}

# Wrapper around hyper-control using the reused scratch client cert.
hyper_ctl () {
    SSL_CERT_FILE="$CA_PEM" "$SCRATCH_DIR/bin/hyper-control" \
        -certDirectory="$CLIENT_DIR" \
        -hypervisorHostname=localhost -hypervisorPortNum="$HYPERVISOR_PORT" \
        "$@"
}

# Define the subnet on the hypervisor and seed the address pool. This is the
# reliable path to end-to-end boot and does not need the fleet-manager. The
# fleet-manager (Task 6) later takes over replenishment from the topology.
bootstrap_pool () {
    echo "[+] adding subnet $SUBNET_ID ($GATEWAY/$NETMASK) to the hypervisor"
    local ns
    ns="$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf)"
    [ -n "$ns" ] || ns="$GATEWAY"
    hyper_ctl add-subnet "$SUBNET_ID" "$GATEWAY" "$NETMASK" "$ns" || true
    echo "[+] seeding address pool $POOL_PREFIX.$POOL_FIRST-$POOL_LAST"
    local i
    for i in $(seq "$POOL_FIRST" "$POOL_LAST"); do
        hyper_ctl add-address "" "$POOL_PREFIX.$i" > /dev/null 2>&1 || true
    done
}

# Temporary stub; replaced in Task 6 with the real fleet-manager pid lookup.
pid_fleet_manager () { true; }

cmd_setup () { echo "TODO"; }

cmd_start () {
    load_state
    net_up
    start_hypervisor
    bootstrap_pool
    echo
    cmd_status
}

cmd_stop () { echo "TODO"; }

cmd_status () {
    load_state
    local pid
    pid=$(pid_hypervisor)
    [ -n "$pid" ] && echo "hypervisor: running (pid=$pid)" || echo "hypervisor: stopped"
    pid=$(pid_fleet_manager 2> /dev/null || true)
    [ -n "$pid" ] && echo "fleet-manager: running (pid=$pid)" || echo "fleet-manager: stopped"
}

cmd_env () { echo "TODO"; }
cmd_create_vm () { echo "TODO"; }
cmd_destroy_vm () { echo "TODO"; }
cmd_teardown () { echo "TODO"; }

main "$@"
